<div id="<%= dom_id(comment) %>" class="rounded-xl border border-slate-300 bg-white p-4 shadow-sm">
  <% [ comment, *comment.replies.sort_by(&:created_at) ].each_with_index do |entry, index| %>
    <div class="<%= "mt-3 border-l-2 border-slate-200 pl-3" if index > 0 %>">
      <div class="mb-1 flex items-center gap-2">
        <span class="truncate text-[13px] font-semibold text-slate-800"><%= entry.author.email_address %></span>
        <% if entry.by_candidate_author? %>
          <span class="shrink-0 rounded-full border border-slate-300 px-1.5 text-[11px] font-medium text-slate-500">Author</span>
        <% end %>
        <span class="ml-auto shrink-0 text-[12px] text-slate-500"><%= entry.created_at.strftime("%-d %b %Y") %></span>
      </div>
      <div class="whitespace-pre-wrap text-[14px] leading-6 text-slate-700"><%= entry.body %></div>
    </div>
  <% end %>
</div>
