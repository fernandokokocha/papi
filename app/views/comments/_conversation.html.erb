<% threads = candidate_comments.threads_for("candidate") %>
<div class="flex flex-col gap-3">
  <div id="candidate_comment_threads" class="flex flex-col gap-3">
    <% threads.each do |thread| %>
      <%= render "comments/conversation_thread", comment: thread %>
    <% end %>
  </div>

  <div id="new_comment_form">
    <%= render "comments/conversation_form", candidate: @candidate %>
  </div>
</div>
