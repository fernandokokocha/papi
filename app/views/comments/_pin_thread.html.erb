<% if thread.resolved? %>
  <div id="<%= dom_id(thread) %>" data-controller="resolved-thread">
    <button type="button" data-action="resolved-thread#toggle"
            class="flex w-full cursor-pointer items-center gap-1.5 rounded bg-slate-100 px-1.5 py-1 text-left ring-1 ring-inset ring-slate-300 hover:bg-slate-200">
      <svg class="h-3.5 w-3.5 shrink-0 text-slate-500" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4.5 10.5 8 14l7.5-8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="truncate text-[11px] text-slate-600">Resolved by <%= thread.resolved_by.email_address %></span>
      <span class="ml-auto shrink-0 text-[11px] text-slate-500"><%= pluralize(thread.replies.size + 1, "comment") %></span>
    </button>
    <div data-resolved-thread-target="body" hidden class="mt-2">
      <%= render "comments/pin_thread_body", thread: thread %>
    </div>
  </div>
<% else %>
  <div id="<%= dom_id(thread) %>" data-live-thread>
    <%= render "comments/pin_thread_body", thread: thread %>
  </div>
<% end %>
