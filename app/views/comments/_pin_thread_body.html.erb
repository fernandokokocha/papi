<% [ thread, *thread.replies.sort_by(&:created_at) ].each_with_index do |comment, index| %>
  <div class="<%= "mt-2 border-l-2 border-slate-200 pl-2" if index > 0 %>">
    <div class="mb-1 flex items-center gap-1.5">
      <span class="truncate text-[12px] font-semibold text-slate-800"><%= comment.author.email_address %></span>
      <% if comment.by_candidate_author? %>
        <span class="shrink-0 rounded-full border border-slate-300 px-1.5 text-[10px] font-medium text-slate-500">Author</span>
      <% end %>
      <span class="ml-auto shrink-0 text-[11px] text-slate-500"><%= comment.created_at.strftime("%-d %b %Y") %></span>
    </div>
    <div class="whitespace-pre-wrap text-[12px] leading-5 text-slate-700"><%= comment.body %></div>
  </div>
<% end %>

<div class="mt-2 flex items-start gap-1.5" data-controller="reply">
  <% if policy(thread).create? %>
    <div class="min-w-0 flex-1">
      <button type="button" data-reply-target="trigger" data-action="reply#show"
              class="w-full cursor-text rounded border border-slate-300 bg-white px-2 py-1 text-left text-[12px] text-slate-400 hover:border-slate-400 hover:text-slate-500">Reply…</button>
      <div data-reply-target="form" hidden>
        <%= render "comments/pin_reply_form", parent: thread %>
      </div>
    </div>
  <% end %>

  <% if thread.resolved? && policy(thread).reopen? %>
    <%= button_to "Reopen", project_candidate_comment_resolution_path(thread.candidate.project.name, thread.candidate.name, thread),
          method: :delete, form: { class: "shrink-0", data: { turbo: true } },
          class: "cursor-pointer rounded border border-slate-300 bg-white px-2 py-1 text-[11px] font-medium text-slate-600 hover:bg-slate-50" %>
  <% elsif policy(thread).resolve? %>
    <%= button_to "Resolve", project_candidate_comment_resolution_path(thread.candidate.project.name, thread.candidate.name, thread),
          form: { class: "shrink-0", data: { turbo: true } },
          class: "cursor-pointer rounded border border-slate-300 bg-white px-2 py-1 text-[11px] font-medium text-slate-600 hover:bg-slate-50" %>
  <% end %>
</div>
