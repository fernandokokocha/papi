<%= render "comments/entries", thread: thread %>

<div class="mt-2 flex items-start gap-1.5" data-controller="reply">
  <% if policy(thread).create? %>
    <div class="min-w-0 flex-1">
      <button type="button" data-reply-target="trigger" data-action="reply#show"
              class="w-full cursor-text rounded border border-slate-400 bg-white px-2 py-1 text-left text-[12px] text-slate-500 hover:bg-slate-50">Reply…</button>
      <div data-reply-target="form" hidden>
        <%= render "comments/pin_reply_form", parent: thread %>
      </div>
    </div>
  <% end %>

  <% if thread.resolved? && policy(thread).reopen? %>
    <%= button_to "Reopen", project_candidate_comment_resolution_path(thread.candidate.project.name, thread.candidate.name, thread),
          method: :delete, form: { class: "shrink-0" },
          class: "cursor-pointer rounded border border-slate-400 bg-white px-2 py-1 text-[12px] font-medium text-slate-700 hover:bg-slate-50" %>
  <% elsif policy(thread).resolve? %>
    <%= button_to "Resolve", project_candidate_comment_resolution_path(thread.candidate.project.name, thread.candidate.name, thread),
          form: { class: "shrink-0" },
          class: "cursor-pointer rounded border border-slate-400 bg-white px-2 py-1 text-[12px] font-medium text-slate-700 hover:bg-slate-50" %>
  <% end %>
</div>
