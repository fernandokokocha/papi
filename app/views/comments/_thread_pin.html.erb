<% outdated = local_assigns[:outdated] || [] %>
<% count = threads.size + outdated.size %>
<%# A removed record has no current text to snapshot, so its lines keep the
    threads they already carry but offer no + to start another. %>
<% composable = local_assigns.fetch(:composable, true) %>
<div class="relative"
     data-controller="margin-note"
     data-action="click@window->margin-note#dismiss keydown.esc@window->margin-note#close"
     data-comment-anchor="<%= anchor.to_columns.to_json %>"
     data-comment-sublabel="<%= sublabel %>">
  <button type="button"
          title="<%= count.zero? ? "Comment here" : pluralize(count, "thread") %>"
          data-action="margin-note#toggle"
          class="anchor-pin flex h-7 w-7 cursor-pointer items-center justify-center rounded-full bg-white <%= "anchor-pin-empty" if count.zero? %>">
    <% unless count.zero? %>
      <svg class="pin-icon-bubble h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path d="M4.5 4h11A1.5 1.5 0 0 1 17 5.5v6a1.5 1.5 0 0 1-1.5 1.5H8.6L5 16v-3h-.5A1.5 1.5 0 0 1 3 11.5v-6A1.5 1.5 0 0 1 4.5 4Z" stroke-linejoin="round"/>
      </svg>
      <svg class="pin-icon-check h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
        <path d="M4.5 10.5 8 14l7.5-8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    <% end %>
    <% if composable %>
      <svg class="pin-icon-plus h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
        <path d="M10 4.5v11M4.5 10h11" stroke-linecap="round"/>
      </svg>
    <% end %>
  </button>
  <% if count > 1 %>
    <span class="anchor-pin-count pointer-events-none absolute -bottom-0.5 -left-0.5 flex h-3.5 min-w-3.5 items-center justify-center rounded-full px-1 text-[9px] font-bold leading-none"><%= count %></span>
  <% end %>

  <div data-margin-note-target="panel" hidden
       class="absolute right-full top-0 z-30 mr-2 flex max-h-96 w-80 flex-col rounded-lg border border-slate-300 bg-white text-left font-normal shadow-lg">
    <div class="flex shrink-0 items-center gap-2 border-b border-slate-200 px-2.5 py-1.5">
      <span class="inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-[0.08em] text-slate-600 ring-1 ring-inset ring-slate-300"><%= comment_kind_style(anchor.kind)[:label] %></span>
      <span class="truncate text-[11px] text-slate-500"><%= sublabel %></span>
      <% if count > 1 %>
        <span class="ml-auto shrink-0 text-[11px] text-slate-500"><%= pluralize(count, "thread") %></span>
      <% end %>
    </div>

    <% unless count.zero? %>
      <div class="min-h-0 overflow-y-auto p-2.5">
        <% threads.each_with_index do |thread, thread_index| %>
          <div class="pin-fresh <%= "mt-3 border-t border-slate-300 pt-3" if thread_index > 0 %>">
            <%= render "comments/pin_thread", thread: thread %>
          </div>
        <% end %>

        <% if outdated.any? %>
          <div class="<%= "mt-3 border-t border-slate-300 pt-3" if threads.any? %>">
            <div class="mb-2 flex items-center gap-2">
              <span class="shrink-0 text-[10px] font-bold uppercase tracking-[0.08em] text-slate-400">Outdated</span>
              <span class="h-px flex-1 bg-slate-200"></span>
            </div>
            <% outdated.each_with_index do |thread, thread_index| %>
              <div class="<%= "mt-3 border-t border-slate-200 pt-3" if thread_index > 0 %>">
                <div class="mb-1.5 rounded border border-dashed border-slate-300 bg-slate-50 px-1.5 py-1 font-mono text-[11px] leading-4 text-slate-500">
                  <span class="font-sans text-[10px] uppercase tracking-wide text-slate-400">line <%= thread.line %> of</span>
                  <span class="break-all"><%= thread.anchor_snapshot %></span>
                </div>
                <%= render "comments/pin_thread", thread: thread %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if composable %>
      <div data-composer-slot class="shrink-0 <%= "border-t border-slate-200" unless count.zero? %>"></div>
    <% end %>
  </div>
</div>
