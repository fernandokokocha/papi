<div class="relative"
     data-controller="margin-note"
     data-action="click@window->margin-note#dismiss keydown.esc@window->margin-note#close">
  <button type="button"
          title="<%= pluralize(threads.size, "thread") %>"
          data-action="margin-note#toggle"
          class="flex h-7 w-7 cursor-pointer items-center justify-center rounded-full bg-white text-sky-600 shadow-sm ring-1 ring-inset ring-sky-300 hover:ring-2 hover:ring-sky-500">
    <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <path d="M4.5 4h11A1.5 1.5 0 0 1 17 5.5v6a1.5 1.5 0 0 1-1.5 1.5H8.6L5 16v-3h-.5A1.5 1.5 0 0 1 3 11.5v-6A1.5 1.5 0 0 1 4.5 4Z" stroke-linejoin="round"/>
    </svg>
  </button>
  <% if threads.size > 1 %>
    <span class="pointer-events-none absolute -bottom-0.5 -left-0.5 flex h-3.5 min-w-3.5 items-center justify-center rounded-full bg-slate-700 px-1 text-[9px] font-bold leading-none text-white"><%= threads.size %></span>
  <% end %>

  <div data-margin-note-target="panel" hidden
       class="absolute right-full top-0 z-30 mr-2 flex max-h-96 w-80 flex-col rounded-lg border border-slate-300 bg-white text-left font-normal shadow-lg">
    <div class="flex shrink-0 items-center gap-2 border-b border-slate-200 px-2.5 py-1.5">
      <span class="inline-flex items-center rounded bg-slate-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-[0.08em] text-slate-600 ring-1 ring-inset ring-slate-300"><%= comment_kind_style(anchor.kind)[:label] %></span>
      <span class="truncate text-[11px] text-slate-500"><%= local_assigns[:sublabel] %></span>
      <% if threads.size > 1 %>
        <span class="ml-auto shrink-0 text-[11px] text-slate-500"><%= pluralize(threads.size, "thread") %></span>
      <% end %>
    </div>

    <div class="min-h-0 overflow-y-auto p-2.5">
      <% threads.each_with_index do |thread, thread_index| %>
        <div class="<%= "mt-3 border-t border-slate-300 pt-3" if thread_index > 0 %>">
          <% [ thread, *thread.replies.sort_by(&:created_at) ].each_with_index do |comment, index| %>
            <div class="<%= "mt-2 border-l-2 border-slate-200 pl-2" if index > 0 %>">
              <div class="mb-1 flex items-center gap-1.5">
                <span class="truncate text-[12px] font-semibold text-slate-800"><%= comment.author.email_address %></span>
                <% if comment.by_candidate_author? %>
                  <span class="shrink-0 rounded-full border border-slate-300 px-1.5 text-[10px] font-medium text-slate-500">Author</span>
                <% end %>
                <span class="ml-auto shrink-0 text-[11px] text-slate-500"><%= comment.created_at.strftime("%-d %b %Y") %></span>
              </div>
              <div class="whitespace-pre-wrap text-[12px] leading-5 text-slate-700"><%= comment.body %></div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
