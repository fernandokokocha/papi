<%# locals: (anchor:, wrapper_class: nil, threads: [], outdated: [], composable: true, sublabel: nil) %>
<% composable = composable && can_comment? %>
<% if @candidate && (composable || threads.any? || outdated.any?) %>
  <div class="anchor-strip absolute -right-10 flex items-center font-sans <%= wrapper_class %>">
    <span class="anchor-line pointer-events-none h-px flex-1"></span>
    <%= render "comments/rail_body", anchor: anchor, threads: threads, outdated: outdated,
               composable: composable, sublabel: sublabel %>
  </div>
<% end %>
