<% if @comment.reply? %>
  <%= turbo_stream.replace dom_id(@comment.parent) do %>
    <%= render "comments/pin_thread", thread: @comment.parent %>
  <% end %>
<% elsif @comment.scope == "candidate" %>
  <%= turbo_stream.remove "no_comments_message" %>
  <%= turbo_stream.append "candidate_comment_threads" do %>
    <%= render "comments/conversation_thread", comment: @comment %>
  <% end %>
  <%= turbo_stream.update "new_comment_form" do %>
    <%= render "comments/conversation_form", candidate: @candidate %>
  <% end %>
  <%= turbo_stream.update sidebar_count_dom_id(CommentAnchor.for_candidate) do %>
    <%= render "comments/count_badge", count: candidate_comments.sidebar_count(CommentAnchor.for_candidate) %>
  <% end %>
<% else %>
  <% anchor = @comment.anchor %>
  <%= turbo_stream.replace anchor.dom_id do %>
    <%= render "comments/rail_body", anchor: anchor,
               threads: candidate_comments.threads_at(anchor),
               outdated: candidate_comments.outdated_lines_under(anchor, @candidate.latest_version),
               sublabel: params[:sublabel] %>
  <% end %>
  <% sidebar_anchor = CommentAnchor.sidebar_for(@comment) %>
  <%= turbo_stream.update sidebar_count_dom_id(sidebar_anchor) do %>
    <%= render "comments/count_badge", count: candidate_comments.sidebar_count(sidebar_anchor) %>
  <% end %>
<% end %>
