<%= form_with model: Comment.new, url: project_candidate_comments_path(candidate.project.name, candidate.name),
              data: { turbo: true }, class: "rounded-xl border border-slate-300 bg-white p-4 shadow-sm" do |form| %>
  <%= form.hidden_field :scope, value: "candidate" %>
  <%= form.hidden_field :part, value: "whole" %>
  <%= form.text_area :body, rows: 3, required: true, placeholder: "Leave a comment…",
        class: "w-full resize-y rounded-lg border border-slate-300 bg-white p-3 text-[14px] leading-6 text-slate-800 placeholder-slate-400 focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
  <div class="mt-2 flex justify-end">
    <%= form.submit "Comment", class: "cursor-pointer rounded-lg bg-sky-600 px-4 py-2 text-[13px] font-semibold text-white hover:bg-sky-700" %>
  </div>
<% end %>
