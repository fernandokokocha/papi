<%= form_with model: Comment.new, url: project_candidate_comments_path(candidate.project.name, candidate.name),
              class: "overflow-hidden rounded-xl border border-slate-400 bg-white shadow-sm focus-within:border-sky-500 focus-within:ring-1 focus-within:ring-sky-500" do |form| %>
  <%= form.hidden_field :scope, value: "candidate" %>
  <%= form.hidden_field :part, value: "whole" %>
  <%= form.text_area :body, rows: 3, required: true, placeholder: "Leave a comment…",
        class: "block w-full resize-y border-0 bg-white px-3 py-2 text-[13px] leading-5 text-slate-800 placeholder-slate-500 focus:outline-none" %>
  <div class="flex justify-end border-t border-slate-200 bg-slate-50 px-2 py-1.5">
    <%= form.submit "Comment", class: "cursor-pointer rounded-md bg-sky-600 px-3 py-1 text-[12px] font-semibold text-white hover:bg-sky-700" %>
  </div>
<% end %>
