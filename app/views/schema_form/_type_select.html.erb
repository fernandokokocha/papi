<%# locals: (row:, source:, url:, css:) %>
<select class="<%= css %>" aria-label="Type" form="<%= SchemaForm::OPS_FORM_ID %>"
        data-controller="schema-edit type-select"
        data-schema-edit-url-value="<%= url %>"
        data-type-select-source-value="<%= source %>"
        data-type-select-taken-value="<%= row.taken.join(",") %>"
        data-action="change->schema-edit#submit pointerdown->type-select#fill focus->type-select#fill">
  <option selected><%= row.type %></option>
</select>
