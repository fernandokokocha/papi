<% panel = "#{block.id}_note_#{index}" %>
<span class="flex shrink-0 items-center" data-controller="note-edit">
  <button type="button" popovertarget="<%= panel %>" data-note-edit-target="badge"
          aria-label="<%= note ? "Edit note" : "Add note" %>" title="<%= note ? note.body : "Add a note" %>"
          class="flex h-4 w-4 cursor-pointer items-center justify-center rounded-full font-sans text-[11px] font-bold leading-none ring-1 ring-inset <%= note ? "bg-slate-300 text-slate-700 ring-slate-400/60" : "text-slate-500 opacity-0 ring-slate-300 hover:bg-slate-200 hover:text-slate-900 focus:opacity-100 group-hover/row:opacity-100" %>">i</button>

  <span popover id="<%= panel %>" data-note-edit-target="panel" data-action="toggle->note-edit#place"
        class="fixed inset-auto m-0 w-80 rounded-lg border-0 bg-white p-2.5 shadow-xl ring-1 ring-slate-900/10">
    <textarea rows="3" form="<%= SchemaForm::OPS_FORM_ID %>" aria-label="Note"
              placeholder="What should a reader know about this?"
              data-controller="schema-edit" data-action="change->schema-edit#submit"
              data-schema-edit-url-value="<%= schema_edit_path(id: block.id, op: "note", note: row.note_key, value: "__VALUE__") %>"
              class="w-full resize-y rounded bg-slate-50 px-2 py-1 font-sans text-[12px] leading-[1.5] text-slate-700 ring-1 ring-inset ring-slate-200 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-600"><%= note.body if note %></textarea>
    <span class="mt-1.5 block text-[11px] leading-none text-slate-400">Clearing the text removes the note.</span>
  </span>
</span>
