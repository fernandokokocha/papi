<% if flash[:alert] %>
  <div class="mb-4 rounded border border-rose-300 bg-rose-50 px-3 py-2 text-[12px] text-rose-800"><%= flash[:alert] %></div>
<% end %>
<% if flash[:notice] %>
  <div class="mb-4 rounded border border-emerald-300 bg-emerald-50 px-3 py-2 text-[12px] text-emerald-800"><%= flash[:notice] %></div>
<% end %>
