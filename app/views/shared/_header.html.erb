<header id="top" class="bg-slate-900">
  <div class="flex h-11 items-center gap-3 px-6">
    <%= link_to "Papi", root_path, class: "logotype text-[19px] tracking-tight text-white no-underline hover:text-slate-300" %>

    <span class="h-5 w-px bg-slate-600"></span>

    <nav class="flex items-center gap-4 text-[12px]">
      <%= link_to "Blog", posts_path, class: "text-slate-300 no-underline hover:text-white" %>
      <%= link_to "About", about_path, class: "text-slate-300 no-underline hover:text-white" %>
      <%= link_to "Projects", projects_path, class: "text-slate-300 no-underline hover:text-white" %>
    </nav>

    <div class="ml-auto flex items-center gap-3">
      <% if @project&.persisted? %>
        <%= link_to @project.name, project_path(@project.name),
              class: "text-[12px] font-bold uppercase tracking-[0.14em] text-slate-300 no-underline hover:text-white" %>
        <span class="h-5 w-px bg-slate-600"></span>
      <% end %>

      <% if Current.user %>
        <span class="text-[12px] text-slate-300"><%= Current.user.email_address %></span>
        <%= button_to "Log out", session_path, method: :delete,
              class: "cursor-pointer rounded-md bg-white px-2.5 py-1 text-[12px] font-semibold text-slate-900 hover:bg-slate-200" %>
      <% else %>
        <%= link_to "Log in", new_session_path,
              class: "rounded-md bg-white px-2.5 py-1 text-[12px] font-semibold text-slate-900 no-underline hover:bg-slate-200" %>
      <% end %>
    </div>
  </div>
</header>
