<% if expandable %>
  <% if expanded %>
    <button type="button" data-action="expandable#collapse" class="text-xs bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 px-2.5 py-0.5 rounded cursor-pointer leading-none">Collapse</button>
  <% else %>
    <button type="button" data-action="expandable#expand" class="text-xs bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 px-2.5 py-0.5 rounded cursor-pointer leading-none">Expand</button>
  <% end %>
<% end %>
