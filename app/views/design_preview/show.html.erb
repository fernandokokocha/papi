<div class="grid grid-cols-2 gap-6 mb-6">

  <div class="bg-white rounded p-6 flex flex-col gap-5 border border-gray-200">
    <div>
      <p class="text-gray-900 font-semibold text-lg">Project: My API</p>
      <p class="text-gray-500 text-sm mt-1">Last updated 2026-01-10</p>
    </div>

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">State badges</p>
      <div class="flex gap-2 flex-wrap">
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-yellow-50 text-yellow-700 border border-yellow-200">Open</span>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">Merged</span>
        <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-red-50 text-red-700 border border-red-200">Rejected</span>
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Input</p>
      <label class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
      <input type="text" placeholder="you@example.com"
             class="w-full border border-gray-300 rounded px-3 py-2 text-sm text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-sky-500">
    </div>

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Select</p>
      <label class="block text-sm font-medium text-gray-700 mb-1">Compared with</label>
      <select class="border border-gray-300 rounded px-3 py-2 bg-white text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-sky-500">
        <option>v9</option>
        <option>v8</option>
        <option>v7</option>
      </select>
      <p class="text-xs text-gray-400 mt-2">Card variant — carries the name typography it replaces</p>
      <select class="border border-gray-300 rounded px-2 py-1 bg-white text-lg font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-sky-500">
        <option>v9</option>
        <option>v8</option>
        <option>v7</option>
      </select>
    </div>

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Monospace / code</p>
      <div class="bg-gray-100 text-gray-800 font-mono text-xs rounded p-3">GET /api/users → 200 OK</div>
    </div>
  </div>

  <div class="bg-white rounded p-6 flex flex-col gap-6 border border-gray-200">

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Primary</p>
      <div class="flex gap-2 flex-wrap">
        <button class="bg-sky-600 hover:bg-sky-700 text-white text-sm px-4 py-2 rounded font-medium">Save</button>
        <button class="bg-sky-600 hover:bg-sky-700 text-white text-sm px-4 py-2 rounded font-medium">Create project</button>
        <button class="bg-sky-600 hover:bg-sky-700 text-white text-sm px-4 py-2 rounded font-medium">Submit</button>
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Secondary — A · sky outline</p>
      <div class="flex gap-2 flex-wrap">
        <button class="bg-white text-sky-700 border border-sky-300 text-sm px-4 py-2 rounded font-medium">Edit</button>
        <button class="bg-white text-sky-700 border border-sky-300 text-sm px-4 py-2 rounded font-medium">View details</button>
        <button class="bg-white text-sky-700 border border-sky-300 text-sm px-4 py-2 rounded font-medium">Cancel</button>
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Secondary — B · gray fill</p>
      <div class="flex gap-2 flex-wrap">
        <button class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm px-4 py-2 rounded font-medium">Edit</button>
        <button class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm px-4 py-2 rounded font-medium">View details</button>
        <button class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm px-4 py-2 rounded font-medium">Cancel</button>
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Secondary — C · gray outline</p>
      <div class="flex gap-2 flex-wrap">
        <button class="bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 text-sm px-4 py-2 rounded font-medium">Edit</button>
        <button class="bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 text-sm px-4 py-2 rounded font-medium">View details</button>
        <button class="bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 text-sm px-4 py-2 rounded font-medium">Cancel</button>
      </div>
    </div>

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Merge &amp; Reject — filled, badge-matched</p>
      <div class="flex gap-2 flex-wrap">
        <button class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm px-4 py-2 rounded font-medium">Merge</button>
        <button class="bg-red-600 hover:bg-red-700 text-white text-sm px-4 py-2 rounded font-medium">Reject</button>
      </div>
    </div>

  </div>
</div>

<div class="bg-white rounded p-6 flex flex-col gap-5 border border-gray-200">
  <p class="text-gray-900 font-semibold text-lg">Endpoints</p>
  <div class="flex flex-col gap-2">
    <%= render "endpoints/endpoint_diff", endpoint: @unchanged_endpoints[1], previous_endpoint: @unchanged_endpoints[0], expanded: false %>
    <%= render "endpoints/endpoint_diff", endpoint: @diff_endpoints[1], previous_endpoint: @diff_endpoints[0], expanded: false %>
    <%= render "endpoints/endpoint_new", endpoint: @new_endpoint, expanded: false %>
    <%= render "endpoints/endpoint_removed", endpoint: @removed_endpoint, expanded: false %>
  </div>
</div>

<div class="bg-white rounded mt-4 p-6 flex flex-col gap-5 border border-gray-200">
  <p class="text-gray-900 font-semibold text-lg">Entities</p>
  <div class="flex flex-col gap-2">
    <%= render "versions/entity_diff", entity: @unchanged_entities[1], previous_entity: @unchanged_entities[0], expanded: false %>
    <%= render "versions/entity_diff", entity: @diff_entities[1], previous_entity: @diff_entities[0], expanded: false %>
    <%= render "versions/entity_added", entity: @new_entity, expanded: false %>
    <%= render "versions/entity_removed", entity: @removed_entity, expanded: false %>
  </div>
</div>

<div class="bg-white rounded mt-4 p-6 flex flex-col gap-5 border border-gray-200">
  <p class="text-gray-900 font-semibold text-lg">Auth methods</p>
  <div class="flex flex-col gap-2">
    <%= render "versions/auth_method_diff", auth_method: @unchanged_auth_methods[1], previous_auth_method: @unchanged_auth_methods[0] %>
    <%= render "versions/auth_method_diff", auth_method: @diff_auth_methods[1], previous_auth_method: @diff_auth_methods[0] %>
    <%= render "versions/auth_method_added", auth_method: @new_auth_method %>
    <%= render "versions/auth_method_removed", auth_method: @removed_auth_method %>
  </div>
</div>

<div class="bg-white rounded mt-4 p-6 border border-gray-200">
  <p class="text-gray-900 font-semibold text-lg mb-1">Note cards</p>
  <p class="text-gray-500 text-sm mb-5">The hover card behind a <span class="line-note"><span class="line-note-badge">i</span></span> badge, shown open.</p>

  <div class="grid grid-cols-3 gap-5">
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Unchanged</p>
      <div class="line-note-card">Opaque. Don't parse it, and don't assume ids are ordered — they are only unique.</div>
    </div>

    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-2">Changed</p>
      <div class="line-note-card">
        <span class="note-was">Lowercased on write. Globally unique.</span>
        <span class="note-now">Lowercased on write. Unique per project, not globally, so the same address can appear in two projects.</span>
      </div>
    </div>
  </div>

  <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide mt-6 mb-2">Badge tints</p>
  <div class="font-mono text-xs bg-white border border-gray-200 rounded p-3 inline-block">
    <div class="line no_change">  id: <span class="number">number</span><span class="line-note"><span class="line-note-badge">i</span></span></div>
    <div class="line no_change">  email: <span class="string">string</span><span class="line-note"><span class="line-note-badge changed">i</span></span></div>
    <div class="line added">  status: <span class="string">string</span><span class="line-note"><span class="line-note-badge added">i</span></span></div>
    <div class="line removed">  legacy_id: <span class="number">number</span><span class="line-note"><span class="line-note-badge removed">i</span></span></div>
  </div>
</div>

<div class="bg-white rounded mt-4 p-6 border border-gray-200">
  <p class="text-gray-900 font-semibold text-lg mb-1">Comment cards</p>
  <p class="text-gray-500 text-sm mb-5">One thread per kind, rendered from the real <span class="font-mono text-xs bg-gray-100 text-gray-800 px-1.5 py-0.5 rounded">comments/thread</span> partial — includes a reply and a resolved thread.</p>
  <div class="flex flex-col gap-3 max-w-2xl">
    <% @preview_comments.each do |comment| %>
      <%= render "comments/thread", comment: comment %>
    <% end %>
  </div>
</div>
