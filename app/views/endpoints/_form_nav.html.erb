<div id="endpoints_nav">
  <% if endpoints.any? %>
    <%= render layout: "versions/sidebar_section", locals: { label: "Endpoints" } do %>
      <% endpoints.each do |endpoint| %>
        <%= render "versions/sidebar_link", href: "#form-endpoint-#{endpoint.key}",
                   title: endpoint.identity_name, name: endpoint.path, verb: endpoint.verb,
                   annotation: checks.endpoint_change(endpoint) %>
      <% end %>
    <% end %>
  <% end %>
</div>
