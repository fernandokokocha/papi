<% lines = node.to_diff("no_change") %>
<% if lines.empty? %>
  <div class="font-mono text-[12px] leading-[18px] text-gray-400">–</div>
<% else %>
  <div class="rounded-md bg-slate-600 px-2.5 py-2">
    <% lines.each do |line| %>
      <div class="whitespace-pre font-mono text-[12px] leading-[18px] text-slate-50"><%= "  " * line.indent %><%= line.whole_line %></div>
    <% end %>
  </div>
<% end %>
