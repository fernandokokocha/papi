<% notes = local_assigns[:notes] || {} %>
<% line_index = local_assigns[:line_index] %>
<% by_line = local_assigns[:line_comments]&.by_line || {} %>
<% line_anchor = local_assigns[:line_anchor] %>
<% type_tint = {
  "string" => "bg-green-100 text-green-800 ring-green-200",
  "number" => "bg-blue-100 text-blue-800 ring-blue-200",
  "boolean" => "bg-orange-100 text-orange-800 ring-orange-200",
  "null" => "bg-red-100 text-red-800 ring-red-200",
  "custom" => "bg-violet-100 text-violet-800 ring-violet-300"
} %>
<% note_tint = {
  no_change: "bg-slate-300 text-slate-700 ring-slate-400/60",
  added: "bg-emerald-500 text-white ring-emerald-600",
  changed: "bg-amber-500 text-white ring-amber-600",
  removed: "bg-rose-500 text-white ring-rose-600"
} %>
<% if lines.nothing? %>
  <div class="font-mono text-[12px] leading-[18px] text-gray-400">–</div>
<% else %>
  <div class="overflow-hidden rounded-md bg-slate-50 py-2 ring-1 ring-inset ring-slate-200">
    <% number = 0 %>
    <% lines.lines.each_with_index do |line, row| %>
      <% number += 1 unless line.change == :blank %>
      <% index = line_index && line_index[row] %>
      <div class="comment-host flex min-h-[18px] border-l-2 border-transparent pr-2.5 <%= change_tint(line.change) if tints %>">
        <% if index %>
          <%= render "comments/rail", wrapper_class: "#{local_assigns[:line_reach]} h-[18px]",
                     anchor: line_anchor.with_line(index), threads: by_line[index] || [],
                     composable: local_assigns.fetch(:line_composable, true),
                     sublabel: "line #{number}" %>
        <% end %>
        <span class="w-8 shrink-0 select-none pr-2 text-right font-mono text-[11px] leading-[18px] text-slate-400"><%= number unless line.change == :blank %></span>
        <span class="whitespace-pre font-mono text-[12px] leading-[18px] text-slate-700"><%= "  " * line.indent %><%= line.pre_type %><% if line.class_name == "custom" %><a href="#entity-<%= line.type %>" class="rounded px-1 ring-1 ring-inset <%= type_tint[line.class_name] %> hover:bg-violet-200 hover:text-violet-900"><%= line.type %></a><% elsif line.type %><span class="rounded px-1 ring-1 ring-inset <%= type_tint[line.class_name] %>"><%= line.type %></span><% end %></span>
        <% note = notes[row] %>
        <% if note %>
          <span class="ml-1.5 flex shrink-0 items-start" data-controller="note-card"
                data-action="mouseenter->note-card#show mouseleave->note-card#hide focusin->note-card#show focusout->note-card#hide">
            <button type="button" tabindex="0"
                    class="mt-[2.5px] flex h-[14px] w-[14px] cursor-help items-center justify-center rounded-full font-sans text-[10px] font-bold leading-none ring-1 ring-inset <%= note_tint[note.state] %>">i</button>
            <span data-note-card-target="card" popover="manual"
                  class="fixed inset-auto m-0 w-72 overflow-visible rounded-lg border-0 bg-white p-3 text-[12px] font-normal leading-[1.5] text-slate-700 shadow-xl ring-1 ring-slate-900/10">
              <% case note.state
                 when :changed %>
                <span class="block rounded bg-rose-100 px-1.5 py-1 text-slate-600 line-through decoration-rose-400/70"><%= note.was %></span>
                <span class="mt-1.5 block rounded bg-emerald-100 px-1.5 py-1"><%= note.body %></span>
              <% when :added %>
                <span class="block rounded bg-emerald-100 px-1.5 py-1"><%= note.body %></span>
              <% when :removed %>
                <span class="block rounded bg-rose-100 px-1.5 py-1 text-slate-600 line-through decoration-rose-400/70"><%= note.body %></span>
              <% else %>
                <%= note.body %>
              <% end %>
            </span>
          </span>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
