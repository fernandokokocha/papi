<% type_tint = {
  "string" => "bg-green-100 text-green-800 ring-green-200",
  "number" => "bg-blue-100 text-blue-800 ring-blue-200",
  "boolean" => "bg-orange-100 text-orange-800 ring-orange-200",
  "null" => "bg-red-100 text-red-800 ring-red-200",
  "custom" => "bg-purple-100 text-purple-800 ring-purple-200"
} %>
<% if lines.nothing? %>
  <div class="font-mono text-[12px] leading-[18px] text-gray-400">–</div>
<% else %>
  <div class="overflow-hidden rounded-md bg-slate-50 py-2 ring-1 ring-inset ring-slate-200">
    <% number = 0 %>
    <% lines.each do |line| %>
      <% number += 1 unless line.change == :blank %>
      <div class="flex min-h-[18px] border-l-2 border-transparent pr-2.5 <%= change_tint(line.change) %>">
        <span class="w-8 shrink-0 select-none pr-2 text-right font-mono text-[11px] leading-[18px] text-slate-400"><%= number unless line.change == :blank %></span>
        <span class="whitespace-pre font-mono text-[12px] leading-[18px] text-slate-700"><%= "  " * line.indent %><%= line.pre_type %><% if line.type %><span class="rounded px-1 ring-1 ring-inset <%= type_tint[line.class_name] %>"><%= line.type %></span><% end %></span>
      </div>
    <% end %>
  </div>
<% end %>
