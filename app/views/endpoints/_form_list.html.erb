<%# locals: (endpoints:, auth_methods:, blocks:, base:, landed: nil) %>
<div id="endpoints" class="flex flex-col gap-4">
  <% endpoints.each do |endpoint| %>
    <%= render "endpoints/form_card", endpoint: endpoint, blocks: blocks,
               auth_methods: auth_methods, base: base, landed: landed %>
  <% end %>
</div>
