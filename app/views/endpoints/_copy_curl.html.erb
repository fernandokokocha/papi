<button type="button"
        title="Copy cURL"
        data-controller="clipboard"
        data-clipboard-verb-value="<%= verb %>"
        data-clipboard-path-value="<%= path %>"
        data-clipboard-query-value="<%= query %>"
        data-clipboard-response-value="<%= code %>"
        data-action="clipboard#copy"
        class="group/copy flex h-5 w-5 shrink-0 cursor-pointer items-center justify-center rounded opacity-60 hover:bg-black/10 hover:opacity-100 data-copied:opacity-100">
  <svg class="h-3.5 w-3.5 group-data-copied/copy:hidden" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <rect x="7.5" y="3" width="9" height="12" rx="1.5" />
    <path d="M13 17H5A1.5 1.5 0 0 1 3.5 15.5V6" stroke-linecap="round" />
  </svg>
  <svg class="hidden h-3.5 w-3.5 text-emerald-600 group-data-copied/copy:block" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
    <path d="M4 10.5l4 4 8-8" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
</button>
