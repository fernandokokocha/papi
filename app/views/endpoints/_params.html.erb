<% endpoint = local_assigns[:endpoint] %>
<% type_tint = {
  "string" => "bg-green-50 text-green-700 ring-green-200",
  "number" => "bg-blue-50 text-blue-700 ring-blue-200",
  "boolean" => "bg-orange-50 text-orange-800 ring-orange-200"
} %>
<div class="grid grid-cols-[max-content_1fr]">
  <% rows.each do |row| %>
    <% if row %>
      <div class="whitespace-pre border-l-2 border-transparent pl-1.5 pr-5 font-mono text-[12px] leading-[18px] text-gray-900 <%= change_tint(row.line.change) if tints %>"><%= row.line.pre_type %></div>
      <div class="flex items-center pr-2 font-mono text-[12px] leading-[18px] <%= change_tint(row.line.change) if tints %>"><span class="rounded px-1 ring-1 ring-inset <%= type_tint[row.line.class_name] %>"><%= row.line.type %></span><% if endpoint %><%= render "comments/thread_region", wrapper_class: reach,
                 anchor: CommentAnchor.for_endpoint_param(endpoint, row.name, location),
                 threads: candidate_comments.threads_for("param", endpoint: endpoint, param_name: row.name, param_location: location),
                 sublabel: row.name %><% end %></div>
    <% else %>
      <div class="h-[18px]"></div>
      <div></div>
    <% end %>
  <% end %>
</div>
