<% notes_diff = DiffText::FromNotes.new(previous_endpoint.note, endpoint.note) %>
<% input_diff = Diff::FromValues.new(previous_endpoint.parsed_input(expanded: expanded), endpoint.parsed_input(expanded: expanded)) %>
<% responses_diff = DiffResponses::FromResponses.new(previous_endpoint.responses, endpoint.responses, expanded: expanded) %>
<% changed = endpoint.differs_from?(previous_endpoint) %>
<% border_class = changed ? "border-amber-200" : "border-gray-200" %>
<% header_class = changed ? "bg-amber-600" : "bg-sky-900" %>
<% expandable = [ previous_endpoint, endpoint ].any? { |e| e.parsed_input.expandable? || e.responses.any? { |r| r.parsed_output.expandable? } } %>

<div class="border <%= border_class %> rounded-lg overflow-hidden">
  <%# Headers %>
  <div class="grid grid-cols-2 sticky top-0 z-10">
    <div class="<%= header_class %> text-white px-4 py-3 text-sm font-mono flex items-center">
      <%= render "endpoints/verb_path", verb: previous_endpoint.verb, path: previous_endpoint.path %>
    </div>
    <div class="<%= header_class %> border-l border-white/20 text-white px-4 py-3 text-sm font-mono flex items-center justify-between">
      <%= render "endpoints/verb_path", verb: endpoint.verb, path: endpoint.path %>
      <div class="flex items-center gap-2 ml-4">
        <% if expandable %>
          <% if expanded %>
            <button type="button" data-action="endpoint#collapse" class="text-xs bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 px-2.5 py-0.5 rounded cursor-pointer leading-none">Collapse</button>
          <% else %>
            <button type="button" data-action="endpoint#expand" class="text-xs bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 px-2.5 py-0.5 rounded cursor-pointer leading-none">Expand</button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Note %>
  <% note_anchor = CommentAnchor.new(scope: "endpoint", part: "note", endpoint_path: endpoint.path, endpoint_http_verb: Endpoint.http_verbs[endpoint.http_verb]) %>
  <div class="grid grid-cols-2 border-t border-gray-300">
    <div class="bg-gray-200 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Note</div>
    <div class="bg-gray-200 border-l border-gray-300 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Note</div>
  </div>
  <div class="grid grid-cols-2">
    <div <%= comment_region_attr(note_anchor) %> class="px-3 py-2 bg-white text-sm text-gray-700"><%= render "specs/text", diff: notes_diff.before %></div>
    <div <%= comment_region_attr(note_anchor) %> class="px-3 py-2 bg-white border-l border-gray-200 text-sm text-gray-700"><%= render "specs/text", diff: notes_diff.after %></div>
    <%= render "comments/anchor_region",
          anchor: note_anchor,
          threads: candidate_comments.threads_for("endpoint", endpoint: endpoint, part: "note"),
          wrapper_class: "col-start-2" %>
  </div>

  <%# Input %>
  <% input_anchor = CommentAnchor.new(scope: "endpoint", part: "input", endpoint_path: endpoint.path, endpoint_http_verb: Endpoint.http_verbs[endpoint.http_verb]) %>
  <% input_lines = candidate_comments.endpoint_input_lines(endpoint) %>
  <% input_map = endpoint_input_line_index_map(previous_endpoint, endpoint, expanded: expanded) %>
  <div class="grid grid-cols-2 border-t border-gray-300">
    <div class="bg-gray-200 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Input</div>
    <div class="bg-gray-200 border-l border-gray-300 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Input</div>
  </div>
  <div class="grid grid-cols-2">
    <div <%= comment_region_attr(input_anchor) %> class="px-3 py-2 bg-white font-mono text-xs text-gray-800"><%= render "specs/json", diff: input_diff.before %></div>
    <div <%= comment_region_attr(input_anchor) %> <%= endpoint_input_line_pick_attr(endpoint, input_map) %> class="px-3 py-2 bg-white border-l border-gray-200 font-mono text-xs text-gray-800"><%= render "specs/json", diff: input_diff.after, comments_by_line: expanded ? input_lines.by_line : {}, line_index_map: input_map %></div>
    <%= render "comments/anchor_region",
          anchor: input_anchor,
          threads: candidate_comments.threads_for("endpoint", endpoint: endpoint, part: "input"),
          wrapper_class: "col-start-2" %>
    <%= render "comments/line_threads", anchor: CommentAnchor.for_endpoint_input(endpoint), collapsed: expanded ? [] : input_lines.fresh, outdated: input_lines.outdated, composable: !input_map.nil?, expanded: expanded, wrapper_class: "col-start-2" %>
  </div>

  <%# Responses — one grid row per code keeps both sides vertically aligned %>
  <div class="grid grid-cols-2 border-t border-gray-300">
    <div class="bg-gray-200 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Responses</div>
    <div class="bg-gray-200 border-l border-gray-300 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Responses</div>
  </div>
  <div class="grid grid-cols-2 gap-x-2 bg-white border-t border-gray-200">
    <% responses_diff.lines.each_with_index do |line, i| %>
      <% if i > 0 %><div class="col-span-2 border-t border-gray-200"></div><% end %>
      <% resp_anchor = CommentAnchor.new(scope: "response", part: "whole", endpoint_path: endpoint.path, endpoint_http_verb: Endpoint.http_verbs[endpoint.http_verb], response_code: line.code) %>
      <% resp_lines = candidate_comments.response_output_lines(endpoint, line.code) %>
      <% resp_map = response_line_index_map(previous_endpoint, endpoint, line.code, expanded: expanded) %>
      <%= render "endpoints/response_cell", line: line, side: :before, region_attr: comment_region_attr(resp_anchor) %>
      <%= render "endpoints/response_cell", line: line, side: :after, curl_verb: endpoint.verb, curl_path: endpoint.path, region_attr: comment_region_attr(resp_anchor), comments_by_line: expanded ? resp_lines.by_line : {}, line_index_map: resp_map, line_pick_attr: response_line_pick_attr(endpoint, line.code, resp_map) %>
      <%= render "comments/anchor_region",
            anchor: resp_anchor,
            threads: candidate_comments.threads_for("response", endpoint: endpoint, response_code: line.code),
            wrapper_class: line.after_present? ? "col-start-2" : "col-start-1" %>
      <%= render "comments/line_threads", anchor: CommentAnchor.for_response_output(endpoint, line.code), collapsed: expanded ? [] : resp_lines.fresh, outdated: resp_lines.outdated, composable: !resp_map.nil?, expanded: expanded, wrapper_class: line.after_present? ? "col-start-2" : "col-start-1" %>
    <% end %>
  </div>
</div>
