<% skin = expanded ? "bg-slate-700 text-white ring-slate-700 hover:bg-slate-800"
                   : "bg-white text-slate-600 ring-slate-300 hover:bg-slate-50" %>
<button type="button"
        data-action="expandable#toggle"
        data-expandable-url-param="<%= url %>"
        class="flex shrink-0 cursor-pointer items-center gap-1 rounded px-1.5 py-0.5 text-[11px] font-medium leading-none ring-1 ring-inset <%= skin %>">
  <svg class="h-3 w-3 transition-transform duration-200 ease-out <%= "-rotate-90" unless expanded %>" viewBox="0 0 20 20"
       fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
    <path d="M5 8l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <%= expanded ? "Collapse" : "Expand" %>
</button>
