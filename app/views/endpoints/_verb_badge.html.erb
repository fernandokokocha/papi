<% tint = {
  "GET" => "bg-blue-50 text-blue-700 ring-blue-200",
  "POST" => "bg-emerald-50 text-emerald-700 ring-emerald-200",
  "PUT" => "bg-violet-50 text-violet-700 ring-violet-200",
  "PATCH" => "bg-amber-50 text-amber-800 ring-amber-200",
  "DELETE" => "bg-red-50 text-red-700 ring-red-200"
}[verb] %><span class="rounded px-1.5 py-1 text-[12px] font-bold font-mono ring-1 ring-inset <%= tint %>"><%= verb %></span>
