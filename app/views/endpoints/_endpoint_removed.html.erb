<% responses_diff = DiffResponses::FromResponses.new(endpoint.responses, [], expanded: expanded ? endpoint.responses.map(&:code) : []) %>
<% input_diff = endpoint.parsed_input(expanded: expanded).to_diff(:removed) %>
<div class="grid grid-cols-2 gap-2">
  <div>
    <div class="border border-red-200 rounded-lg">
      <div class="sticky top-0 z-10 rounded-t-lg bg-red-700 text-white px-4 py-3 text-sm font-mono flex items-center justify-between">
        <%= render "endpoints/verb_path", verb: endpoint.verb, path: endpoint.path %>
        <div class="flex items-center gap-2 ml-4">
          <%= render "shared/expand_button", expandable: endpoint.parsed_input.expandable? || endpoint.responses.any? { |r| r.parsed_output.expandable? }, expanded: expanded %>
        </div>
      </div>
      <% if endpoint.path_params.any? %>
        <div class="bg-gray-200 border-t border-gray-300 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Params</div>
        <div class="px-3 py-2 bg-white border-b border-gray-200 font-mono text-xs text-gray-800"><%= render "endpoints/params_cell", rows: DiffParams::FromParams.new(endpoint.path_params, []).before_rows, side: :before, endpoint: endpoint, location: "path" %></div>
      <% end %>
      <% if endpoint.query_params.any? %>
        <div class="bg-gray-200 border-t border-gray-300 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Query</div>
        <div class="px-3 py-2 bg-white border-b border-gray-200 font-mono text-xs text-gray-800"><%= render "endpoints/params_cell", rows: DiffParams::FromParams.new(endpoint.query_params, []).before_rows, side: :before, endpoint: endpoint, location: "query" %></div>
      <% end %>
      <% if endpoint.auth.present? %>
        <% auth_line = DiffAuth::FromAuth.new(endpoint.auth_method, nil).before_line %>
        <div class="bg-gray-200 border-t border-gray-300 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Auth</div>
        <div class="px-3 py-2 bg-white border-b border-gray-200 font-mono text-xs text-gray-800"><div class="line <%= auth_line.change %>"><%= auth_line.whole_line %></div></div>
      <% end %>
      <div class="bg-gray-200 border-t border-gray-300 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Note</div>
      <% note_anchor = CommentAnchor.new(scope: "endpoint", part: "note", endpoint_path: endpoint.path, endpoint_http_verb: Endpoint.http_verbs[endpoint.http_verb]) %>
      <div <%= comment_region_attr(note_anchor) %> class="px-3 py-2 bg-white border-b border-gray-200 text-sm text-gray-700"><%= endpoint.note %></div>
      <%= render "comments/anchor_region",
            anchor: note_anchor,
            threads: candidate_comments.threads_for("endpoint", endpoint: endpoint, part: "note"),
            wrapper_class: "" %>
      <div class="bg-gray-200 border-t border-gray-300 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Input</div>
      <% input_anchor = CommentAnchor.new(scope: "endpoint", part: "input", endpoint_path: endpoint.path, endpoint_http_verb: Endpoint.http_verbs[endpoint.http_verb]) %>
      <% input_lines = candidate_comments.endpoint_input_lines(endpoint) %>
      <div <%= comment_region_attr(input_anchor) %> class="px-3 py-2 bg-white border-b border-gray-200 font-mono text-xs text-gray-800"><%= render "specs/json", diff: input_diff, comments_by_line: expanded ? input_lines.by_line : {}, notes_by_row: schema_notes_by_row(endpoint, nil, input_diff) %></div>
      <%= render "comments/anchor_region",
            anchor: input_anchor,
            threads: candidate_comments.threads_for("endpoint", endpoint: endpoint, part: "input"),
            wrapper_class: "" %>
      <%= render "comments/line_threads", anchor: CommentAnchor.for_endpoint_input(endpoint), collapsed: expanded ? [] : input_lines.fresh, outdated: input_lines.outdated, composable: false, expanded: expanded, wrapper_class: "" %>
      <div class="bg-gray-200 border-t border-gray-300 px-3 py-1.5 text-xs font-semibold text-black uppercase tracking-wide">Responses</div>
      <div class="bg-white border-b border-gray-200"><%= render "specs/responses", lines: responses_diff.lines, side: :before, endpoint: endpoint, expanded: expanded %></div>
    </div>
  </div>
  <div></div>
</div>
