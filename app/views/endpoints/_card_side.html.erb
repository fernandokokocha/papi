<div class="rounded-lg border border-gray-300 bg-white">
  <div class="sticky top-0 z-10 flex items-center rounded-t-lg border-b border-gray-300 bg-gray-50 px-1 py-1 transition-[border-radius,border-bottom-width] duration-200 ease-out group-has-[>input:checked]:rounded-b-lg group-has-[>input:checked]:border-b-0">
    <%= render "endpoints/verb_badge", verb: endpoint.verb %>
    <span class="whitespace-pre font-mono text-[13px] font-medium text-gray-900"> <%= endpoint.path %></span>

    <label for="<%= fold_id %>"
           class="ml-auto flex h-5 w-5 shrink-0 cursor-pointer select-none items-center justify-center rounded text-gray-500 hover:bg-gray-200 hover:text-gray-900">
      <svg class="h-3.5 w-3.5 transition-transform duration-200 ease-out group-has-[>input:checked]:-rotate-90" viewBox="0 0 20 20"
           fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 8l5 5 5-5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </label>
  </div>

  <div class="grid grid-rows-[1fr] transition-[grid-template-rows] duration-200 ease-out group-has-[>input:checked]:grid-rows-[0fr]">
    <div class="overflow-hidden">
      <%= render "endpoints/section_band", label: "Note" %>
      <div class="px-3 py-2 text-sm text-gray-700"><%= endpoint.note %></div>

      <%= render "endpoints/section_band", label: "Input" %>
      <div class="px-3 py-2 font-mono text-xs text-gray-700"><%= endpoint.input.presence || "–" %></div>

      <%= render "endpoints/section_band", label: "Responses" %>
      <div class="flex flex-col gap-2 px-3 py-2">
        <% endpoint.responses.each do |response| %>
          <div>
            <div class="text-sm text-gray-700"><%= response.code %> <%= response.note %></div>
            <div class="font-mono text-xs text-gray-700"><%= response.output.presence || "–" %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
