<div class="mb-6">
  <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= @project.name %></div>
  <h1 class="text-2xl font-semibold text-gray-900">Import OpenAPI</h1>
</div>

<% if flash[:alert] %>
  <div class="mb-6 px-4 py-3 bg-red-50 border border-red-200 text-red-700 rounded text-sm"><%= flash[:alert] %></div>
<% end %>

<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-2xl">
  <p class="text-sm text-gray-600 mb-6">
    The document becomes a new candidate on top of <span class="font-semibold text-gray-900"><%= @project.latest_version.name.presence || "an empty project" %></span>,
    replacing the whole spec — anything the file leaves out reads as a removal in the diff.
    What Papi cannot express is dropped: security schemes, header params, formats, examples and tags.
  </p>

  <%= form_with url: project_openapi_import_path(project_name: @project.name), method: :post, html: { multipart: true } do |f| %>
    <%= file_field_tag :document, required: true, accept: ".json,.yaml,.yml,application/json,application/yaml",
          class: "block w-full text-sm text-gray-700 mb-6 file:mr-4 file:py-2 file:px-4 file:rounded file:border file:border-gray-300 file:bg-white file:text-sm file:font-medium file:text-gray-700 hover:file:bg-gray-50" %>

    <div class="flex items-center gap-3">
      <%= f.submit "Import", class: "bg-sky-600 hover:bg-sky-700 text-white text-sm font-medium px-4 py-2 rounded cursor-pointer" %>
      <%= link_to "Cancel", root_path, class: "bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 text-sm font-medium px-4 py-2 rounded" %>
    </div>
  <% end %>
</div>
