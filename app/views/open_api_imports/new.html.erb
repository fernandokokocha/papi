<% content_for :main_class, "mx-auto w-full max-w-[26rem] px-6 py-14" %>

<div class="border border-slate-300 bg-white">
  <div class="border-b border-slate-300 px-6 py-4">
    <div class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-600"><%= @project.name %></div>
    <h1 class="mt-1 text-2xl font-normal tracking-tight text-slate-700">Import OpenAPI</h1>
  </div>

  <div class="px-6 py-5">
    <%= render "shared/flash" %>

    <p class="text-[12px] leading-relaxed text-slate-600">
      The document becomes a new candidate on top of
      <span class="font-semibold text-slate-900"><%= @project.latest_version.name.presence || "an empty project" %></span>.
    </p>

    <%= form_with url: project_openapi_import_path(project_name: @project.name), method: :post, html: { multipart: true } do |form| %>
      <%= label_tag :document, "Document", class: "mt-5 block text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600" %>
      <%= file_field_tag :document,
            required: true, accept: ".json,.yaml,.yml,application/json,application/yaml",
            class: "mt-1 block w-full cursor-pointer rounded-md border border-slate-300 bg-white text-[13px] text-slate-700 file:mr-3 file:cursor-pointer file:border-0 file:bg-slate-100 file:px-3 file:py-2 file:text-[13px] file:font-semibold file:text-slate-900 hover:file:bg-slate-200" %>

      <%= form.submit "Import", class: "mt-5 w-full cursor-pointer rounded-md border border-sky-800 bg-sky-700 px-3 py-2 text-[13px] font-semibold text-white hover:bg-sky-800" %>
    <% end %>
  </div>

  <div class="border-t border-slate-300 px-6 py-3">
    <%= link_to "Cancel", project_path(@project.name), class: "text-[12px] text-sky-700 hover:underline" %>
  </div>
</div>
