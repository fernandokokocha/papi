<% ops = SchemaForm::OPS_FORM_ID %>
<% removed = block.removed %>
<% added = base_entity.nil? && !removed %>
<% diff = Diff::FromValues.new(base_entity.parsed_root, root) if base_entity && !removed %>
<% changed = diff && record.differs_from?(base_entity) %>
<% columns = added || removed ? 1 : 2 %>
<% col = if added then "col-start-2" elsif removed then "col-start-1" else "" end %>
<% header_tint = if added
     "border-emerald-700 bg-emerald-700 text-white"
   elsif removed
     "border-rose-700 bg-rose-700 text-white"
   elsif changed
     "border-amber-400 bg-amber-100 text-slate-900"
   else
     "border-violet-400 bg-violet-100 text-violet-900"
   end %>
<% edge = if added
     "border-x-2 border-b-2 border-emerald-500"
   elsif removed
     "border-x-2 border-b-2 border-rose-500"
   elsif changed
     "border-x border-b border-amber-400"
   else
     "border-x border-b border-violet-400"
   end %>
<div id="form-entity-<%= block.id %>" data-sidebar-target="card"
     data-controller="<%= "landing" if landed %>"
     class="group grid grid-cols-2 gap-x-2 scroll-mt-[var(--pinned-offset)]">
  <% if removed %>
    <%= render "schema_form/ops_fields", block: block %>
    <%= hidden_field_tag "blocks[#{block.id}][removed]", "1", id: nil, form: ops %>
  <% else %>
    <%= hidden_field_tag "version[entities_attributes][#{index}][name]", block.name, id: nil %>
    <% if block.added %>
      <%= hidden_field_tag "blocks[#{block.id}][added]", "1", id: nil, form: ops %>
    <% end %>
  <% end %>

  <div class="sticky top-[var(--pinned-offset)] z-10 col-span-2 grid grid-cols-2 gap-x-2 bg-slate-100">
    <% columns.times do |column| %>
      <div class="flex items-center gap-3 rounded-t-xl border px-2 py-2 shadow-sm <%= col %> <%= header_tint %>">
        <span class="truncate font-mono text-[13px] font-medium <%= "line-through decoration-white/60" if removed %>"><%= block.name %></span>

        <% if column == columns - 1 %>
          <% if removed %>
            <button type="submit" form="<%= ops %>" formaction="<%= schema_edit_path(id: block.id, op: "restore_entity") %>"
                    class="ml-auto shrink-0 cursor-pointer rounded px-1.5 py-0.5 text-[11px] font-medium leading-none opacity-90 hover:bg-white/25 hover:opacity-100">Restore</button>
          <% elsif !referenced %>
            <button type="submit" form="<%= ops %>" title="<%= block.added ? "Discard entity" : "Remove entity" %>"
                    formaction="<%= schema_edit_path(id: block.id, op: block.added ? "drop_entity" : "remove_entity") %>"
                    class="ml-auto flex h-5 w-5 shrink-0 cursor-pointer items-center justify-center rounded font-mono text-[13px] leading-none opacity-0 focus:opacity-100 group-hover:opacity-60 group-hover:hover:opacity-100 <%= block.added ? "hover:bg-white/25" : "hover:bg-rose-200 hover:text-rose-800" %>">&times;</button>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if columns == 2 %>
    <div class="rounded-b-xl bg-white px-3 py-2 shadow-sm <%= edge %>">
      <%= render "endpoints/schema", lines: diff.before, tints: true,
                 notes: schema_notes_by_row(base_entity, nil, diff.before) %>
    </div>
  <% end %>

  <div class="rounded-b-xl bg-white px-3 py-2 shadow-sm <%= col %> <%= edge %> <%= "opacity-60" if removed %>">
    <% if removed %>
      <%= render "endpoints/schema", lines: root.to_diff(:no_change), tints: false %>
    <% else %>
      <%= render "schema_form/editor", root: root, block: block, nothing: false,
                 referenceable_names: referenceable_names %>
    <% end %>
  </div>
</div>
