<% new_entity = local_assigns[:new_entity] %>
<% error = local_assigns[:error] %>
<div id="entities" class="flex flex-col gap-4">
  <% blocks.entities.each_with_index do |block, index| %>
    <%= render "entities/form_card", block: block, index: index,
               root: blocks.parse(block),
               base_entity: base.entities.find { |entity| entity.identity_name == block.name },
               referenceable_names: blocks.referenceable_names(block),
               referenced: blocks.referenced?(block) %>
  <% end %>

  <div class="rounded-xl border border-dashed border-slate-300 px-2 py-2" data-turbo="true">
    <div class="flex items-center gap-2">
      <span class="select-none font-mono text-[13px] leading-[18px] text-slate-400">+</span>
      <%= text_field_tag :new_entity, new_entity, id: nil, form: SchemaForm::OPS_FORM_ID, placeholder: "MyResource",
            autocomplete: "off", data: { controller: "schema-edit", action: "keydown.enter->schema-edit#submit",
                                         schema_edit_url_value: schema_edit_path(op: "add_entity") },
            class: "w-48 rounded bg-white px-1.5 font-mono text-[13px] leading-[18px] text-slate-700 placeholder-slate-400 ring-1 ring-inset #{error ? "ring-rose-400" : "ring-slate-300"} focus:outline-none focus:ring-2 focus:ring-sky-600" %>
      <button type="submit" form="<%= SchemaForm::OPS_FORM_ID %>" formaction="<%= schema_edit_path(op: "add_entity") %>"
              class="cursor-pointer rounded px-2 py-0.5 text-[11px] font-medium text-slate-600 ring-1 ring-inset ring-slate-300 hover:bg-white hover:text-slate-900">Add entity</button>
      <% if error %>
        <span class="text-[11px] text-rose-700"><%= error %></span>
      <% end %>
    </div>
  </div>
</div>
