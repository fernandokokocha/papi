<div id="entity-<%= entity.name %>" class="group scroll-mt-[var(--pinned-offset)]" data-controller="expandable" data-sidebar-target="card">
  <input type="checkbox" id="fold_entity_<%= entity.id %>" class="sr-only">

  <div class="flex items-start gap-3">
    <div class="relative min-w-0 flex-1" data-expandable-target="container">
      <%= render "entities/card_body", entity: entity, expanded: false, base: base, project_name: project_name %>
    </div>

    <div class="w-7 shrink-0"></div>
  </div>
</div>
