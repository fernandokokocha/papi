<% content_for :main_class, "mx-auto w-full max-w-[26rem] px-6 py-14" %>

<div class="border border-slate-300 bg-white">
  <div class="border-b border-slate-300 px-6 py-4">
    <h1 class="text-2xl font-normal tracking-tight text-slate-700">Update your password</h1>
  </div>

  <div class="px-6 py-5">
    <%= render "shared/flash" %>

    <%= form_with url: password_path(params[:token]), method: :put do |form| %>
      <%= form.label :password, "New password", class: "block text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600" %>
      <%= form.password_field :password,
            required: true, autofocus: true, autocomplete: "new-password",
            placeholder: "••••••••", maxlength: 72,
            class: "mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-[13px] text-slate-900 placeholder-slate-400 focus:border-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-200" %>

      <%= form.label :password_confirmation, "Confirm password", class: "mt-4 block text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600" %>
      <%= form.password_field :password_confirmation,
            required: true, autocomplete: "new-password",
            placeholder: "••••••••", maxlength: 72,
            class: "mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-[13px] text-slate-900 placeholder-slate-400 focus:border-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-200" %>

      <%= form.submit "Save password", class: "mt-5 w-full cursor-pointer rounded-md border border-sky-800 bg-sky-700 px-3 py-2 text-[13px] font-semibold text-white hover:bg-sky-800" %>
    <% end %>
  </div>

  <div class="border-t border-slate-300 px-6 py-3">
    <%= link_to "Back to sign in", new_session_path, class: "text-[12px] text-sky-700 hover:underline" %>
  </div>
</div>
