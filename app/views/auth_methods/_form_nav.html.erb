<%# locals: (auth_methods:, checks:, asking: nil) %>
<div id="auth_methods_nav" data-controller="new-form" data-new-form-host-value="auth_methods_nav"
     data-new-form-open-value="<%= "auth" if asking %>">
  <%= render layout: "versions/sidebar_section", locals: { label: "Auth", add_kind: "auth" } do %>
    <%= render "versions/new_field", kind: "auth", host: "auth_methods_nav", open: asking.present?,
               value: asking&.fetch(:value), error: asking&.fetch(:error) %>
    <% auth_methods.each_with_index do |auth_method, index| %>
      <%= render "versions/sidebar_link", href: "#form-auth-#{index}",
                 title: auth_method.name, name: auth_method.name,
                 annotation: checks.auth_method_change(auth_method) %>
    <% end %>
  <% end %>
</div>
