<% pill = { "open" => "bg-amber-600", "merged" => "bg-emerald-600", "rejected" => "bg-rose-600" }[@candidate.aasm_state] %>

<header class="border-b border-slate-400 px-6 py-4">
  <div class="flex items-center gap-6">
    <div class="min-w-0 flex-1">
      <h1 class="text-2xl font-normal tracking-tight text-slate-700">
        Candidate <%= @candidate.name %>
        <% if @candidate.promoted_version %>
          as <%= link_to @candidate.promoted_version.name, project_version_path(@project.name, @candidate.promoted_version.name),
                   class: "text-sky-700 hover:underline" %>
        <% end %>
      </h1>

      <div class="mt-2.5 space-y-1 text-[12px] text-slate-500">
        <div class="flex items-center gap-2">
          <span class="inline-block rounded-full <%= pill %> px-3 py-1 text-[13px] font-semibold text-white"><%= @candidate.aasm_state.capitalize %></span>
          <% if @candidate.decided_by %>
            <span>by <%= render "shared/actor", user: @candidate.decided_by %> on <%= @candidate.decided_at.strftime("%-d %b %Y") %></span>
          <% elsif @candidate.author %>
            <span>Proposed by <%= render "shared/actor", user: @candidate.author %> on <%= @candidate.created_at.strftime("%-d %b %Y") %></span>
          <% end %>
        </div>
        <% if @candidate.decided_by && @candidate.author %>
          <div>Proposed by <%= render "shared/actor", user: @candidate.author %> on <%= @candidate.created_at.strftime("%-d %b %Y") %></div>
        <% end %>
      </div>
    </div>
  </div>
</header>
