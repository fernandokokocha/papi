<% content_for :topbar_class, "w-full" %>
<% content_for :main_class, "w-full" %>

<div class="group flex" data-controller="sidebar composer" data-sidebar="open"
     data-action="margin-note:open->composer#attach margin-note:close->composer#park turbo:submit-start@document->composer#submitted">
<%= render "versions/sidebar" %>
<div class="min-w-0 flex-1 px-6 pb-16 pt-6">
<div class="mb-4"><%= render "versions/sidebar_toggle" %></div>
<div class="mb-6 flex items-center justify-between">
  <div>
    <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= @project.name %></div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-semibold text-gray-900"><%= @candidate.name %></h1>
      <% state_classes = case @candidate.aasm_state
         when "open"     then "bg-yellow-50 text-yellow-700 border border-yellow-200"
         when "merged"   then "bg-emerald-50 text-emerald-700 border border-emerald-200"
         when "rejected" then "bg-red-50 text-red-700 border border-red-200"
         end %>
      <span class="<%= state_classes %> text-xs font-semibold px-2.5 py-1 rounded-full"><%= @candidate.aasm_state.capitalize %></span>
    </div>
    <div class="text-sm text-gray-500 mt-1">
      <% if @candidate.author %>Proposed by <%= @candidate.author.email_address %><% end %>
      <% if @candidate.decided_by %>
        <%= " · " if @candidate.author %><%= @candidate.merged? ? "Merged" : "Rejected" %> by <%= @candidate.decided_by.email_address %>
      <% end %>
    </div>
    <% if @candidate.approvals.any? %>
      <div class="flex items-center gap-2 mt-2">
        <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-semibold px-2.5 py-1 rounded-full">👍 <%= @candidate.approvals.size %></span>
        <span class="text-sm text-gray-500">Approved by <%= @candidate.approvers.map(&:email_address).join(", ") %></span>
      </div>
    <% end %>
  </div>

  <% if @candidate.open? %>
    <div class="flex items-center gap-3">
      <% if @candidate.approved_by?(Current.user) %>
        <%= button_to "Approved ✓", project_candidate_approval_path(@project.name, @candidate.name), method: :delete, class: "bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100 text-sm font-medium px-4 py-2 rounded cursor-pointer" %>
      <% elsif policy(Approval.new(candidate: @candidate, user: Current.user)).create? %>
        <%= button_to "👍 Approve", project_candidate_approval_path(@project.name, @candidate.name), class: "bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 text-sm font-medium px-4 py-2 rounded cursor-pointer" %>
      <% end %>
      <%= button_to "Edit", edit_project_candidate_path(@project.name, @candidate.name), method: :get, class: "bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 text-sm font-medium px-4 py-2 rounded cursor-pointer" %>
      <%= button_to "Reject", project_candidate_rejection_path(@project.name, @candidate.name), class: "bg-red-600 hover:bg-red-700 text-white text-sm font-medium px-4 py-2 rounded cursor-pointer" %>
      <%= button_to "Merge", project_candidate_merge_path(@project.name, @candidate.name), class: "bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded cursor-pointer" %>
    </div>
  <% elsif @candidate.merged? %>
    <div class="flex items-center gap-3">
      <%= link_to "View version → #{@candidate.promoted_version.name}", project_version_path(@project.name, @candidate.promoted_version.name), class: "bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 text-sm font-medium px-4 py-2 rounded" %>
    </div>
  <% end %>
</div>

<%= render layout: "versions/section", locals: { label: "Conversation", id: "conversation" } do %>
  <%= render "comments/conversation" %>
<% end %>

<%= render "versions/release_notes_section" %>
<%= render "versions/endpoints_and_entities" %>

<%= render "comments/composer" %>

</div>
</div>
