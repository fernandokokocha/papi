<%# locals: (approvers:) %>
<% if approvers.any? %>
  <span class="flex items-center gap-1.5">
    <svg class="h-3.5 w-3.5 shrink-0 text-emerald-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd" />
    </svg>
    <%= safe_join(approvers.map { |approver| render("shared/actor", user: approver) }, ", ") %>
  </span>
<% else %>
  —
<% end %>
