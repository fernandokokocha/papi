<% content_for :main_class, "w-full" %>

<%= render "projects/header", project: @project, active: :releases %>

<div class="flex">
  <%= render "projects/rail", project: @project, tab: @tab, versions: @versions, candidates: @candidates,
             selected_version: @version, selected_candidate: @candidate %>

  <div class="min-w-0 flex-1 bg-white">
    <%= render "projects/version_panel", project: @project, version: @version if @version %>
    <%= render "projects/candidate_panel", project: @project, candidate: @candidate if @candidate %>
  </div>
</div>
