<%# locals: (project:, candidate:) %>
<% base = candidate.base_version %>
<% notes = candidate.proposed_version.release_notes %>
<% threads = candidate.comments.count { |comment| comment.parent_id.nil? } %>
<% chip = {
     "open" => "border-amber-300 bg-amber-100 text-amber-800",
     "merged" => "border-emerald-300 bg-emerald-100 text-emerald-800",
     "rejected" => "border-rose-300 bg-rose-100 text-rose-800"
   }[candidate.aasm_state] %>

<div class="flex max-w-4xl flex-col gap-5 px-8 py-6">
  <div class="flex items-center gap-3.5">
    <span class="font-mono text-[32px] font-bold tracking-tight text-slate-900"><%= candidate.name %></span>
    <span class="rounded border px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-[0.08em] <%= chip %>"><%= candidate.aasm_state %></span>
    <% if candidate.open? %>
      <%= link_to "Edit", edit_project_candidate_path(project.name, candidate.name),
            class: "ml-auto rounded-md border border-slate-400 bg-white px-3 py-1.5 text-[13px] font-semibold text-slate-900 hover:bg-slate-50" %>
    <% end %>
  </div>

  <%= link_to project_candidate_path(project.name, candidate.name),
        class: "flex items-center gap-3 rounded-lg border border-sky-800 bg-sky-700 px-4.5 py-3 text-[15px] font-semibold text-white no-underline hover:bg-sky-800" do %>
    <% if base %>
      <span>Review the diff against <span class="font-mono"><%= base.name %></span></span>
    <% else %>
      <span>Review <span class="font-mono"><%= candidate.name %></span></span>
    <% end %>
    <svg class="ml-auto h-4.5 w-4.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path d="M7.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 1 1-1.06-1.06L10.94 10 7.22 6.28a.75.75 0 0 1 0-1.06Z"/>
    </svg>
  <% end %>

  <dl class="grid grid-cols-[7.75rem_minmax(0,1fr)] gap-x-4 gap-y-2.5 border-y border-slate-200 py-4 text-[12px] text-slate-600">
    <dt class="text-[10px] font-bold uppercase tracking-[0.12em]">Opened by</dt>
    <dd>
      <% if candidate.author %>
        <%= render "shared/actor", user: candidate.author %> on <%= candidate.created_at.strftime("%-d %b %Y") %>
      <% else %>
        —
      <% end %>
    </dd>

    <dt class="text-[10px] font-bold uppercase tracking-[0.12em]">Over</dt>
    <dd>
      <% if base %>
        <%= link_to base.name, project_version_path(project.name, base.name), class: "font-mono font-semibold text-sky-700 hover:underline" %>
      <% else %>
        —
      <% end %>
    </dd>

    <% if candidate.open? %>
      <dt class="text-[10px] font-bold uppercase tracking-[0.12em]">Open for</dt>
      <dd><%= pluralize((Date.current - candidate.created_at.to_date).to_i, "day") %></dd>
    <% else %>
      <dt class="text-[10px] font-bold uppercase tracking-[0.12em]"><%= candidate.merged? ? "Merged by" : "Rejected by" %></dt>
      <dd>
        <% if candidate.decided_by %><%= render "shared/actor", user: candidate.decided_by %> on <% end %><%= candidate.decided_at.strftime("%-d %b %Y") %>
        <% if candidate.promoted_version %>
          as <%= link_to candidate.promoted_version.name, project_version_path(project.name, candidate.promoted_version.name), class: "font-mono font-semibold text-sky-700 hover:underline" %>
        <% end %>
      </dd>
    <% end %>

    <dt class="text-[10px] font-bold uppercase tracking-[0.12em]">Approved by</dt>
    <dd><%= render "projects/approvers", approvers: candidate.approvers %></dd>

    <dt class="text-[10px] font-bold uppercase tracking-[0.12em]">Conversation</dt>
    <dd><%= threads.zero? ? "—" : pluralize(threads, "thread") %></dd>
  </dl>

  <div class="flex flex-col gap-2">
    <span class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600">Draft release notes</span>
    <% if notes.present? %>
      <div class="max-w-[68ch] whitespace-pre-line text-[13px] leading-relaxed text-slate-700"><%= notes %></div>
    <% else %>
      <span class="text-[13px] text-slate-300">—</span>
    <% end %>
  </div>
</div>
