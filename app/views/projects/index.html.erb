<% content_for :main_class, "w-full" %>

<header class="border-b border-slate-400 px-6 py-4">
  <div class="flex items-center gap-6">
    <h1 class="min-w-0 flex-1 text-2xl font-normal tracking-tight text-slate-900"><%= @group.name %></h1>
    <%= link_to "New project", new_project_path,
          class: "rounded-md border border-sky-800 bg-sky-700 px-3 py-1.5 text-[13px] font-semibold text-white hover:bg-sky-800" %>
  </div>
</header>

<div class="divide-y divide-slate-300">
  <% @projects.each do |project| %>
    <% latest = project.latest_version %>
    <% open_candidate = project.candidates.open.first %>
    <div class="flex items-center gap-6 px-6 py-4 hover:bg-white/70">
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline gap-3">
          <%= link_to project.name, project_path(project.name),
                class: "text-[17px] font-semibold text-sky-700 hover:underline" %>
          <% if latest.persisted? %>
            <%= link_to latest.name, project_version_path(project.name, latest.name),
                  class: "font-mono text-[13px] font-bold text-slate-900 hover:text-sky-800 hover:underline" %>
            <span class="text-[12px] text-slate-500"><%= latest.created_at.strftime("%-d %b %Y") %></span>
          <% else %>
            <span class="font-mono text-[13px] italic text-slate-400">no version yet</span>
          <% end %>
        </div>

        <% if open_candidate %>
          <div class="mt-1 flex items-center gap-2 text-[12px] text-slate-500">
            <span class="rounded border border-amber-300 bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-[0.08em] text-amber-800">Open</span>
            <%= link_to open_candidate.name, project_candidate_path(project.name, open_candidate.name),
                  class: "font-mono text-sky-700 hover:underline" %>
            <% if open_candidate.author %>
              <span>by <%= render "shared/actor", user: open_candidate.author %></span>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="flex shrink-0 items-center gap-2">
        <%= link_to "Import OpenAPI", new_project_openapi_import_path(project_name: project.name),
              class: "rounded-md border border-slate-400 bg-white px-3 py-1.5 text-[13px] font-semibold text-slate-900 hover:bg-slate-50" %>
        <% if project.can_create_candidate? %>
          <%= link_to "New candidate", new_project_candidate_path(project_name: project.name),
                class: "rounded-md border border-sky-800 bg-sky-700 px-3 py-1.5 text-[13px] font-semibold text-white hover:bg-sky-800" %>
        <% else %>
          <span title="<%= open_candidate.name %> is still open"
                class="cursor-not-allowed rounded-md border border-slate-300 bg-slate-200 px-3 py-1.5 text-[13px] font-semibold text-slate-400">New candidate</span>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
