<% content_for :main_class, "w-full" %>

<% row = "grid grid-cols-[200px_68px_100px_76px_76px_180px_40px_40px_minmax(0,1fr)] items-center gap-x-3 px-6" %>

<header class="flex h-[38px] items-center border-b border-slate-400 bg-white px-6">
  <h1 class="text-[15px] font-semibold text-slate-900"><%= @group.name %></h1>
  <%= link_to "New project", new_project_path,
        class: "ml-auto rounded border border-sky-800 bg-sky-700 px-2 py-1 text-[12px] font-semibold leading-none text-white hover:bg-sky-800" %>
</header>

<div class="<%= row %> border-b border-slate-400 py-2 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600">
  <span>Project</span>
  <span>Current</span>
  <span>Published</span>
  <span>State</span>
  <span>Candidate</span>
  <span>Author</span>
  <span class="justify-self-end" title="Comment threads">
    <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <path d="M4.5 4h11A1.5 1.5 0 0 1 17 5.5v6a1.5 1.5 0 0 1-1.5 1.5H8.6L5 16v-3h-.5A1.5 1.5 0 0 1 3 11.5v-6A1.5 1.5 0 0 1 4.5 4Z" stroke-linejoin="round"/>
    </svg>
  </span>
  <span class="justify-self-end" title="Approvals">
    <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-7.5 7.5a1 1 0 01-1.4 0L3.3 9.7a1 1 0 111.4-1.4l3.8 3.8 6.8-6.8a1 1 0 011.4 0z" clip-rule="evenodd"/>
    </svg>
  </span>
  <span>Latest release notes</span>
</div>

<div class="divide-y divide-slate-200 border-b border-slate-400 bg-white">
  <% @projects.each do |project| %>
    <% latest = project.latest_version %>
    <% candidate = project.candidates.open.first %>
    <div class="<%= row %> h-8 hover:bg-slate-50">
      <%= link_to project.name, project_path(project.name),
            class: "truncate text-[14px] font-semibold text-sky-700 hover:underline" %>

      <% if latest.persisted? %>
        <%= link_to latest.name, project_version_path(project.name, latest.name),
              class: "font-mono text-[13px] font-bold text-slate-900 hover:text-sky-800 hover:underline" %>
        <span class="font-mono text-[12px] tabular-nums text-slate-600"><%= latest.created_at.strftime("%-d %b %Y") %></span>
      <% else %>
        <span class="font-mono text-[13px] text-slate-300">—</span>
        <span class="text-[12px] text-slate-300">—</span>
      <% end %>

      <% if candidate %>
        <% threads = candidate.comments.count { |comment| comment.parent_id.nil? } %>
        <% approvals = candidate.approvals.size %>
        <span class="justify-self-start rounded border border-amber-300 bg-amber-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-[0.08em] text-amber-800">Open</span>
        <%= link_to candidate.name, project_candidate_path(project.name, candidate.name),
              class: "font-mono text-[12px] font-semibold text-sky-700 hover:underline" %>
        <% if candidate.author %>
          <span class="truncate text-[12px]"><%= render "shared/actor", user: candidate.author %></span>
        <% else %>
          <span class="text-[12px] text-slate-300">—</span>
        <% end %>
        <span class="text-right font-mono text-[12px] text-slate-600"><%= threads.zero? ? "—" : threads %></span>
        <span class="text-right font-mono text-[12px] text-slate-600"><%= approvals.zero? ? "—" : approvals %></span>
      <% else %>
        <span class="text-[12px] text-slate-300">—</span>
        <span class="text-[12px] text-slate-300">—</span>
        <span class="text-[12px] text-slate-300">—</span>
        <span class="text-right text-[12px] text-slate-300">—</span>
        <span class="text-right text-[12px] text-slate-300">—</span>
      <% end %>

      <% if latest.persisted? && latest.release_notes.present? %>
        <span class="truncate text-[12px] text-slate-600"><%= latest.release_notes.squish %></span>
      <% else %>
        <span class="text-[12px] text-slate-300">—</span>
      <% end %>
    </div>
  <% end %>
</div>
