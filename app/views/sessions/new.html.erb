<% content_for :main_class, "mx-auto w-full max-w-[26rem] px-6 py-14" %>

<div class="border border-slate-400 bg-white">
  <div class="border-b border-slate-400 px-6 py-4">
    <h1 class="text-2xl font-normal tracking-tight text-slate-700">Sign in</h1>
  </div>

  <div class="px-6 py-5">
    <%= render "shared/flash" %>

    <%= form_with url: session_path do |form| %>
      <%= form.label :email_address, "Email address", class: "block text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500" %>
      <%= form.email_field :email_address,
            required: true, autofocus: true, autocomplete: "username",
            placeholder: "you@example.com", value: params[:email_address],
            class: "mt-1 w-full rounded-md border border-slate-400 bg-white px-3 py-2 text-[13px] text-slate-900 placeholder-slate-400 focus:border-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-200" %>

      <%= form.label :password, "Password", class: "mt-4 block text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500" %>
      <%= form.password_field :password,
            required: true, autocomplete: "current-password",
            placeholder: "••••••••", maxlength: 72,
            class: "mt-1 w-full rounded-md border border-slate-400 bg-white px-3 py-2 text-[13px] text-slate-900 placeholder-slate-400 focus:border-sky-600 focus:outline-none focus:ring-2 focus:ring-sky-200" %>

      <%= form.submit "Sign in", class: "mt-5 w-full cursor-pointer rounded-md border border-sky-800 bg-sky-700 px-3 py-2 text-[13px] font-semibold text-white hover:bg-sky-800" %>
    <% end %>
  </div>

  <div class="border-t border-slate-300 px-6 py-3">
    <%= link_to "Forgot password?", new_password_path, class: "text-[12px] text-sky-700 hover:underline" %>
  </div>
</div>
