<header class="border-b border-slate-400 px-6 py-3">
  <div class="flex items-center gap-3">
    <span class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-500"><%= @project.name %></span>
    <span class="text-slate-400">/</span>
    <%= link_to candidate.name, project_candidate_path(@project.name, candidate.name),
          class: "font-mono text-[12px] text-sky-700 hover:text-sky-800 hover:underline" %>
    <h1 class="ml-1 font-mono text-xl font-bold tracking-tight text-slate-900"><%= @version.name %></h1>
    <span class="text-[12px] text-slate-500"><%= @version.created_at.strftime("%-d %b %Y") %></span>

    <div class="ml-auto flex items-center gap-2">
      <nav class="inline-flex divide-x divide-slate-300 overflow-hidden rounded-md border border-slate-400 bg-white font-mono text-[12px] font-bold">
        <% if @previous_version.order > -1 %>
          <%= link_to "← #{@previous_version.name}", project_version_path(project_name: @project.name, name: @previous_version.name), class: "inline-flex w-20 items-center justify-center py-1 text-slate-900 hover:bg-slate-50" %>
        <% else %>
          <span class="inline-flex w-20 items-center justify-center bg-slate-100 py-1 text-slate-400">←</span>
        <% end %>
        <% if @next_version %>
          <%= link_to "#{@next_version.name} →", project_version_path(project_name: @project.name, name: @next_version.name), class: "inline-flex w-20 items-center justify-center py-1 text-slate-900 hover:bg-slate-50" %>
        <% else %>
          <span class="inline-flex w-20 items-center justify-center bg-slate-100 py-1 text-slate-400">→</span>
        <% end %>
      </nav>

      <%= link_to "Export OpenAPI", project_version_openapi_path(project_name: @project.name, version_name: @version.name),
            class: "rounded-md border border-slate-400 bg-white px-3 py-1.5 text-[13px] font-semibold text-slate-900 hover:bg-slate-50" %>
      <% if @project.can_create_candidate? %>
        <%= link_to "New candidate", new_project_candidate_path(project_name: @project.name),
              class: "rounded-md border border-sky-800 bg-sky-700 px-3 py-1.5 text-[13px] font-semibold text-white hover:bg-sky-800" %>
      <% else %>
        <span title="<%= @project.candidates.open.first.name %> is still open"
              class="cursor-not-allowed rounded-md border border-slate-300 bg-slate-200 px-3 py-1.5 text-[13px] font-semibold text-slate-400">New candidate</span>
      <% end %>
    </div>
  </div>

  <div class="mt-1 flex flex-wrap items-center gap-x-2 text-[13px] text-slate-600">
    <% events.each_with_index do |(label, user, at), index| %>
      <% if index > 0 %><span class="text-slate-400">·</span><% end %>
      <span><%= label %> by</span>
      <span class="font-medium text-slate-800"><%= user.email_address %></span>
      <% if user == Current.user %>
        <span class="inline-flex items-center rounded bg-sky-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-[0.08em] text-sky-700 ring-1 ring-inset ring-sky-300">you</span>
      <% end %>
      <span><%= at.strftime("%-d %b %Y") %></span>
    <% end %>
  </div>
</header>
