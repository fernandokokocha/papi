<aside data-sidebar-target="aside"
       class="relative ml-[calc(50%-50vw+0.5rem)] w-[calc(14rem+50vw-50%-0.5rem)] shrink-0 transition-[width] duration-200 ease-out">
  <div class="sticky top-2 z-20 flex max-h-[calc(100vh-1rem)] w-full flex-col rounded-xl border border-slate-300 bg-white shadow-sm transition-[width,transform] duration-200 ease-out [.sidebar-collapsed_&]:w-6 [.sidebar-collapsed_&]:-translate-x-8 [.sidebar-collapsed_&]:border-0 [.sidebar-collapsed_&]:bg-transparent [.sidebar-collapsed_&]:shadow-none">
    <div class="flex h-9 shrink-0 items-center rounded-t-xl border-b border-slate-300 bg-slate-100 px-3 [.sidebar-collapsed_&]:border-b-0 [.sidebar-collapsed_&]:bg-transparent [.sidebar-collapsed_&]:px-0">
      <span class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-500 [.sidebar-collapsed_&]:hidden">Contents</span>
      <button type="button"
              data-sidebar-target="button"
              data-action="sidebar#toggle"
              class="ml-auto flex h-6 w-6 cursor-pointer items-center justify-center rounded border border-slate-400 bg-white text-slate-600 shadow-sm hover:bg-slate-50 hover:text-slate-900">
        <svg class="h-3.5 w-3.5 transition-transform duration-200 ease-out [.sidebar-collapsed_&]:rotate-180" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M12 5l-5 5 5 5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    <div class="min-h-0 overflow-y-auto px-3 py-3 [.sidebar-collapsed_&]:hidden"></div>
  </div>
</aside>
