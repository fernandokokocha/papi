<% base_version = @candidate.base_version || Version.null_version(@project) %>
<% auth_methods = SchemaForm::AuthMethods.for_version(@version.auth_methods, base_version) %>
<% blocks = SchemaForm::Blocks.for_version(@version, base_version) %>
<% endpoints = SchemaForm::Endpoints.for_version(@version.endpoints, base_version) %>
<% checks = SchemaForm::Checks.new(endpoints: endpoints, blocks: blocks, auth_methods: auth_methods, base: base_version) %>

<%= form_with url: schema_edit_path, id: SchemaForm::OPS_FORM_ID do %>
  <%= hidden_field_tag :base_version_id, base_version.id, id: nil %>
<% end %>

<div class="group [--pinned-offset:2.75rem]" data-sidebar="open"
     data-controller="sidebar ops-lock ops-metrics"
     data-ops-lock-form-id-value="<%= SchemaForm::FORM_ID %>"
     data-action="turbo:submit-start@document->ops-lock#lock turbo:submit-end@document->ops-lock#unlock
                  turbo:before-fetch-request@document->ops-metrics#request
                  turbo:before-fetch-response@document->ops-metrics#response
                  turbo:submit-end@document->ops-metrics#report">
  <div data-ops-lock-target="backdrop" class="fixed inset-0 z-40 hidden cursor-wait bg-white/50">
    <div class="flex h-[var(--pinned-offset)] items-center justify-center">
      <span class="flex items-center gap-2 rounded-md border border-slate-400 bg-white px-3 py-1.5 text-[13px] font-semibold text-slate-900 shadow-sm">
        <svg viewBox="0 0 24 24" fill="none" class="h-4 w-4 animate-spin text-slate-500">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-25"/>
          <path d="M12 2a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
        </svg>
        Updating…
      </span>
    </div>
  </div>

  <div class="flex">
    <%= render "versions/form_sidebar", endpoints: endpoints, blocks: blocks,
               auth_methods: auth_methods, checks: checks %>

    <div class="min-w-0 flex-1">
      <div class="sticky top-0 z-20 flex h-[var(--pinned-offset)] items-center gap-3 bg-slate-100 px-4">
        <%= render "versions/sidebar_toggle" %>
        <span class="text-[13px] font-semibold text-slate-900"><%= heading %></span>

        <div class="ml-auto flex items-center gap-3">
          <%= render "versions/new_menu" %>
          <%= link_to "Cancel", cancel_path,
                class: "rounded-md border border-slate-400 bg-white px-3 py-1.5 text-[13px] font-semibold text-slate-900 hover:bg-slate-50" %>
          <%= render "versions/submit_bar", checks: checks %>
          <%= render "versions/top_link" %>
        </div>
      </div>

      <div class="px-4 pb-16 pt-2">
        <%= form_with model: [@project, @candidate], id: SchemaForm::FORM_ID do |f| %>
          <%= f.hidden_field :project_id %>
          <%= f.hidden_field :order %>
          <%= f.hidden_field :name %>
          <%= hidden_field(:version, :order) %>
          <%= hidden_field(:version, :name) %>

          <div class="mb-6 grid grid-cols-2 gap-x-2">
            <div class="flex items-center gap-3 pr-3">
              <div class="ml-auto flex items-center gap-3">
                <span class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600">Compared with</span>
                <% if base_version.order == -1 %>
                  <span class="font-mono text-[13px] text-slate-500">—</span>
                <% else %>
                  <span class="font-mono text-[13px] font-bold text-slate-900"><%= base_version.name %></span>
                  <span class="text-[12px] text-slate-600"><%= base_version.created_at.strftime("%-d %b %Y") %></span>
                <% end %>
              </div>
            </div>

            <div class="flex items-center gap-3 pl-3">
              <span class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-600">Proposed</span>
              <span class="font-mono text-[13px] font-bold text-slate-900"><%= @version.name %></span>
              <span class="text-[12px] text-slate-600"><%= @version.created_at.strftime("%-d %b %Y") %></span>
            </div>
          </div>

          <%= render layout: "versions/section", locals: { label: "Release notes", id: "release-notes" } do %>
            <div class="grid grid-cols-2 gap-x-2">
              <div></div>
              <%= text_area :version, :release_notes, rows: 5,
                    class: "w-full resize-y rounded-xl border border-slate-400 bg-white p-4 text-[14px] leading-6 text-slate-700 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
            </div>
          <% end %>

          <%= render layout: "versions/section", locals: { label: "Endpoints" } do %>
            <%= render "endpoints/form_list", endpoints: endpoints,
                       auth_methods: auth_methods, blocks: blocks, base: base_version %>
          <% end %>

          <%= render layout: "versions/section", locals: { label: "Entities" } do %>
            <%= render "entities/form_list", blocks: blocks, base: base_version %>
          <% end %>

          <%= render layout: "versions/section", locals: { label: "Auth" } do %>
            <%= render "auth_methods/form_list", auth_methods: auth_methods, base: base_version %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
