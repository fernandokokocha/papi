<div class="mb-6 flex items-center justify-between">
  <div>
    <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1"><%= @project.name %></div>
    <h1 class="text-2xl font-semibold text-gray-900"><%= @version.name %></h1>
    <div class="text-sm text-gray-500 mt-1"><%= @version.created_at.strftime("%Y-%m-%d") %></div>
    <% candidate = @version.candidate %>
    <div class="text-sm text-gray-500 mt-1">
      <% if candidate.author %>Proposed by <%= candidate.author.email_address %><% end %>
      <% if candidate.decided_by %>
        <%= " · " if candidate.author %><%= candidate.merged? ? "Merged" : "Rejected" %> by <%= candidate.decided_by.email_address %>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= link_to "Export OpenAPI", project_version_openapi_path(project_name: @project.name, version_name: @version.name), class: "bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 text-sm font-medium px-4 py-2 rounded" %>

    <%= link_to "View candidate → #{candidate.name}", project_candidate_path(@project.name, candidate.name), class: "bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 text-sm font-medium px-4 py-2 rounded" %>

    <% if @previous_version.order > -1 %>
      <%= link_to "← #{@previous_version.name}", project_version_path(name: @previous_version.name, project_name: @previous_version.project.name), class: "bg-white text-gray-700 border border-gray-300 text-sm font-medium px-4 py-2 rounded" %>
    <% else %>
      <span class="bg-gray-100 text-gray-400 text-sm font-medium px-4 py-2 rounded">←</span>
    <% end %>

    <% if @next_version.present? && @next_version.order > -1 %>
      <%= link_to "#{@next_version.name} →", project_version_path(name: @next_version.name, project_name: @next_version.project.name), class: "bg-white text-gray-700 border border-gray-300 text-sm font-medium px-4 py-2 rounded" %>
    <% else %>
      <span class="bg-gray-100 text-gray-400 text-sm font-medium px-4 py-2 rounded">→</span>
    <% end %>

    <% if @project.can_create_candidate? %>
      <%= link_to "Import OpenAPI", new_project_openapi_import_path(project_name: @project.name), class: "bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 text-sm font-medium px-4 py-2 rounded" %>
      <%= link_to "New candidate", new_project_candidate_path(project_name: @project.name), class: "bg-sky-600 hover:bg-sky-700 text-white text-sm font-medium px-4 py-2 rounded" %>
    <% else %>
      <span class="bg-gray-100 text-gray-400 text-sm font-medium px-4 py-2 rounded">Import OpenAPI</span>
      <span class="bg-gray-100 text-gray-400 text-sm font-medium px-4 py-2 rounded">New candidate</span>
    <% end %>
  </div>
</div>

<%= render "versions/endpoints_and_entities" do %>
  <div class="grid grid-cols-2 gap-2 mb-6">
    <div class="bg-white border border-gray-200 rounded-lg p-4">
      <% if @comparison.before.order > -1 %>
        <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Compared with</div>
        <%= form_with url: project_version_path(project_name: @project.name, name: @version.name), method: :get do %>
          <%= select_tag :base,
                options_for_select(@version.earlier_versions.map(&:name), @comparison.before.name),
                onchange: "this.form.requestSubmit()",
                class: "border border-gray-300 rounded px-2 py-1 bg-white text-lg font-semibold text-gray-900 focus:outline-none focus:ring-2 focus:ring-sky-500" %>
        <% end %>
        <div class="text-sm text-gray-500"><%= @comparison.before.created_at.strftime("%Y-%m-%d") %></div>
      <% else %>
        <div class="text-sm text-gray-400 italic">No previous version</div>
      <% end %>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg p-4">
      <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Current</div>
      <div class="text-lg font-semibold text-gray-900"><%= @version.name %></div>
      <div class="text-sm text-gray-500"><%= @version.created_at.strftime("%Y-%m-%d") %></div>
    </div>
  </div>

  <%= render "versions/release_notes", version: @version %>
<% end %>
