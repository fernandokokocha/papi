<% candidate = @version.candidate %>
<% events = [] %>
<% events << [ "Proposed", candidate.author, candidate.created_at ] if candidate.author %>
<% events << [ candidate.merged? ? "Merged" : "Rejected", candidate.decided_by, candidate.decided_at ] if candidate.decided_by %>

<div class="-mt-6 [--pinned-offset:3rem]" data-controller="sidebar">
  <%= render "versions/identity", candidate: candidate, events: events %>

  <div class="mt-2 flex gap-6">
    <%= render "versions/sidebar" %>

    <div class="min-w-0 flex-1">
      <%= render "versions/comparison_rail" %>
      <%= render "versions/release_notes_row" %>

      <div class="mt-6">
        <%= render "versions/endpoints_and_entities" %>
      </div>
    </div>
  </div>
</div>
