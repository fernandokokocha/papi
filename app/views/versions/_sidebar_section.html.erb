<%# locals: (label:, add_kind: nil) %>
<details open class="fold group/fold">
  <summary class="-mx-3 flex h-7 cursor-pointer list-none items-center gap-1.5 px-2 text-slate-700 hover:bg-white hover:text-slate-900 [&::-webkit-details-marker]:hidden">
    <svg viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3 shrink-0 text-slate-400 transition-transform duration-200 group-open/fold:rotate-90">
      <path d="M7.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 1 1-1.06-1.06L10.94 10 7.22 6.28a.75.75 0 0 1 0-1.06Z"/>
    </svg>
    <span class="text-[12px] font-semibold"><%= label %></span>
    <% if add_kind %>
      <button type="button" data-kind="<%= add_kind %>" data-action="new-form#ask"
              title="New <%= add_kind == "auth" ? "auth method" : add_kind %>"
              class="ml-auto flex h-5 w-5 shrink-0 cursor-pointer items-center justify-center rounded font-mono text-[15px] leading-none text-slate-500 hover:bg-white hover:text-slate-900">+</button>
    <% end %>
  </summary>
  <div class="-mx-3 ml-2 border-l border-slate-200">
    <%= yield %>
  </div>
</details>
