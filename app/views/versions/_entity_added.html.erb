<% diff = entity.parsed_root(expanded: expanded).to_diff(:no_change) %>
<% entity_lines = candidate_comments.entity_root_lines(entity) %>
<% entity_map = entity_line_index_map(nil, entity, expanded: expanded) %>

<div class="grid grid-cols-2 gap-2">
  <div></div>
  <div>
    <div class="border border-emerald-200 rounded-lg">
      <div class="sticky top-0 z-10 rounded-t-lg bg-emerald-700 text-white px-4 py-2 text-sm font-mono flex items-center justify-between">
        <%= entity.name %>
        <%= render "shared/expand_button", expandable: entity.parsed_root.expandable?, expanded: expanded %>
      </div>
      <div <%= entity_line_pick_attr(entity, entity_map) %> class="pl-2 py-2 bg-emerald-50 border-b border-emerald-200"><%= render "specs/json", diff: diff, comments_by_line: expanded ? entity_lines.by_line : {}, line_index_map: entity_map %></div>
    </div>
  </div>
  <%= render "comments/line_threads", anchor: CommentAnchor.for_entity_root(entity), collapsed: expanded ? [] : entity_lines.fresh, outdated: entity_lines.outdated, composable: !entity_map.nil?, expanded: expanded, wrapper_class: "col-start-2 mt-3" %>
</div>
