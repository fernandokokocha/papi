<% anchor = CommentAnchor.for_release_notes %>
<% if version.release_notes.present? || @candidate %>
  <div id="release-notes" <%= comment_region_attr(anchor) %> data-sidebar-target="card" class="w-1/2 ml-auto pl-1 mb-6 scroll-mt-6 rounded-xl">
    <div class="bg-white border border-gray-200 rounded-lg p-4">
      <div class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Release Notes</div>
      <% if version.release_notes.present? %>
        <div class="flex flex-col gap-2">
          <%= simple_format h(version.release_notes), class: "text-sm text-gray-700" %>
        </div>
      <% else %>
        <div class="text-sm text-gray-400 italic">No release notes</div>
      <% end %>
    </div>
    <%= render "comments/anchor_region",
          anchor: anchor,
          threads: candidate_comments.threads_for("release_notes"),
          wrapper_class: "mt-3" %>
  </div>
<% end %>
